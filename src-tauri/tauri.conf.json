{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tender PRO Desktop Foundation",
  "version": "0.1.0",
  "identifier": "ua.tenderpro.desktop.foundation",
  "build": {
    "beforeDevCommand": "npm run desktop:frontend:dev",
    "beforeBuildCommand": "npm run desktop:frontend:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tender PRO — Desktop Foundation · локальні тестові дані",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
